    "theme": "田园",
    "difficulty": "入门",
    "lines": [
      {"text": "锄禾日当午，", "pinyin": "chú hé rì dāng wǔ", "words": ["锄禾", "日当午", "，"], "keyword": "锄禾", "meaning": "正午的太阳下，农民还在给庄稼锄草。", "image": "field"},
