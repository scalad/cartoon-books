      {"text": "黄河入海流。", "pinyin": "huáng hé rù hǎi liú", "words": ["黄河", "入海", "流", "。"], "keyword": "黄河", "meaning": "黄河奔流着，向大海流去。", "image": "river"},
      {"text": "欲穷千里目，", "pinyin": "yù qióng qiān lǐ mù", "words": ["欲", "穷", "千里目", "，"], "keyword": "远望", "meaning": "如果想把很远的景色都看清，", "image": "mountain"},
