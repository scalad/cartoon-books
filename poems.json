    "author": "李白",
    "authorPinyin": "lǐ bái",
    "dynasty": "唐",
    "theme": "月夜",
    "difficulty": "入门",
    "lines": [
      {"text": "床前明月光，", "pinyin": "chuáng qián míng yuè guāng", "words": ["床前", "明月", "光", "，"], "keyword": "月光", "meaning": "明亮的月光洒在床前。", "image": "moon"},
      {"text": "疑是地上霜。", "pinyin": "yí shì dì shàng shuāng", "words": ["疑是", "地上", "霜", "。"], "keyword": "白霜", "meaning": "看起来像地上铺了一层白霜。", "image": "moon"},
      {"text": "举头望明月，", "pinyin": "jǔ tóu wàng míng yuè", "words": ["举头", "望", "明月", "，"], "keyword": "抬头", "meaning": "我抬起头望着明亮的月亮。", "image": "moon"},
      {"text": "低头思故乡。", "pinyin": "dī tóu sī gù xiāng", "words": ["低头", "思", "故乡", "。"], "keyword": "家乡", "meaning": "低下头时，又想起了自己的家乡。", "image": "family"}
    ],
    "notes": ["疑：怀疑，这里是觉得像。", "举头：抬起头。", "故乡：自己原来生活的家乡。"],
    "scene": "安静的夜里，一个人坐在床边。月光铺在地上，他望望月亮，又想起远方的家。"
  },
  {
    "id": "chun-xiao",
    "title": "春晓",
    "titlePinyin": "chūn xiǎo",
