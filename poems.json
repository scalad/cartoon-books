    "theme": "田园",
    "difficulty": "进阶",
    "lines": [
      {"text": "春种一粒粟，", "pinyin": "chūn zhòng yī lì sù", "words": ["春", "种", "一粒粟", "，"], "keyword": "播种", "meaning": "春天种下一粒谷子，", "image": "field"},
      {"text": "秋收万颗子。", "pinyin": "qiū shōu wàn kē zǐ", "words": ["秋", "收", "万颗子", "。"], "keyword": "秋收", "meaning": "秋天就能收获许多谷粒。", "image": "field"},
