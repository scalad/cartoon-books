      {"text": "谁知盘中餐，", "pinyin": "shéi zhī pán zhōng cān", "words": ["谁", "知", "盘中餐", "，"], "keyword": "饭菜", "meaning": "有谁知道盘子里的饭食，", "image": "field"},
      {"text": "粒粒皆辛苦。", "pinyin": "lì lì jiē xīn kǔ", "words": ["粒粒", "皆", "辛苦", "。"], "keyword": "米粒", "meaning": "每一粒都来自农民辛苦的劳动。", "image": "field"}
    ],
