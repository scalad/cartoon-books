      {"text": "日照香炉生紫烟，", "pinyin": "rì zhào xiāng lú shēng zǐ yān", "words": ["日照", "香炉", "生", "紫烟", "，"], "keyword": "紫烟", "meaning": "阳光照在香炉峰上，升起紫色的云雾。", "image": "mountain"},
      {"text": "遥看瀑布挂前川。", "pinyin": "yáo kàn pù bù guà qián chuān", "words": ["遥看", "瀑布", "挂", "前川", "。"], "keyword": "瀑布", "meaning": "远远望去，瀑布像挂在山前的一条大河。", "image": "river"},
